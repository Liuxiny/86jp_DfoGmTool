root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

[*.{csproj,xml,json}]
indent_style = space
indent_size = 2

[*.{js,html,css}]
indent_style = space
indent_size = 2

[*.bat]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
