# Copy to /etc/dfo-gm/dfo-gm.env, chmod 0600 and fill on the server only.
DFO_GM_MYSQL_CONNECTION_STRING=<server-only>
DFO_GM_PVF_PATH=/opt/dfo-server/Data/Pvf/Script.pvf
DFO_GM_SERVER_LOG_PATH=/opt/dfo-server/server.log
DFO_GM_BOOTSTRAP_ACCOUNT=<initial-level-3-account>
DFO_GM_LISTEN_URL=https://0.0.0.0:8001
ASPNETCORE_Kestrel__Certificates__Default__Path=/etc/dfo-gateway/tls/gateway.pfx
ASPNETCORE_Kestrel__Certificates__Default__Password=<server-only>
