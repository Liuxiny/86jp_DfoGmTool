<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- dist 是发布输出目录，必须排除默认项目项，避免再次发布时递归打包旧产物。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;.tmp\**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- 发布件不带调试符号 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- PvfLib 是子目录里的独立工程, 不让本工程把它的源码再编译一遍 -->
    <Compile Remove="PvfLib\**" />
    <Content Remove="PvfLib\**" />
    <None Remove="PvfLib\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- ServerCore\ 是服务端业务源码: 发物品/改等级等操作走服务端同一套业务代码, 代码随工具入库 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <ProjectReference Include="PvfLib\PvfLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 自带 schema 拷贝: 服务端目录缺 Sqlite\item_schema.sql 时的回退(见 GmConfig.SchemaPath) -->
    <Content Include="ServerCore\Sqlite\item_schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="awakening_skill_grants.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="config.ini" LogicalName="DfoGmTool.config.ini" />
  </ItemGroup>
  <Target Name="CopyDefaultConfigToBuildOutput" AfterTargets="Build" Condition="!Exists('$(OutDir)config.ini')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\config.ini" DestinationFiles="$(OutDir)config.ini" />
  </Target>
  <Target Name="CopyDefaultConfigToPublishOutput" AfterTargets="Publish" Condition="!Exists('$(PublishDir)config.ini')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\config.ini" DestinationFiles="$(PublishDir)config.ini" />
  </Target>
</Project>
